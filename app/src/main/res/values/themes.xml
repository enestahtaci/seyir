<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark palette close to YouTube on TV, so the layout feels familiar; name and logo are our own. -->
    <color name="page">#0F0F0F</color>
    <color name="panel">#181818</color>
    <color name="surface">#272727</color>
    <color name="text">#F1F1F1</color>
    <color name="muted">#AAAAAA</color>
    <color name="accent">#FF3D3D</color>
    <color name="focus">#FFFFFF</color>
    <color name="badge">#CC000000</color>

    <style name="Theme.Seyir" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Seyir.Nav" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/nav_background</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- One settings row: "Name" on the left, the current value on the right; OK changes it. -->
    <style name="Seyir.Setting" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/setting_background</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Seyir.Tab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/nav_background</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
