<?xml version="1.0" encoding="utf-8"?>
<!-- One video card: 16:9 thumbnail with a duration/live badge, then title (2 lines) and channel · views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/thumbFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/card_focus"
        android:duplicateParentState="true">

        <io.github.enestahtaci.akis.ui.WideImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/thumb_placeholder"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/badge_background"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- How much was watched: a red line along the bottom, scaled in code (no layout pass). -->
        <View
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="15sp" />
</LinearLayout>
