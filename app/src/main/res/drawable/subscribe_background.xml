<?xml version="1.0" encoding="utf-8"?>
<!-- Like YouTube: white "Abone ol"; grey once subscribed (selected). Focus adds an accent frame. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="3dp" android:color="@color/focus" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/focus" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
